# ==============================================================================
# TalentLens - Production & Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your deployment-specific configuration.
# NEVER commit .env to version control or expose production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Neon / RDS)
# ------------------------------------------------------------------------------
# Pooled database connection string for Prisma ORM.
# Required in all environments.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talentlens?schema=public"

# Optional direct connection string for database migrations (e.g. Neon serverless direct URL).
# DIRECT_URL="postgresql://postgres:postgres@ep-direct.neon.tech/talentlens?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AI Resume Screening Engine (OpenAI API)
# ------------------------------------------------------------------------------
# Mandatory in production. The screening engine computes deterministic 100% weighted
# scorecards, extracts verbatim evidence citations, and strips protected demographic attributes.
# SAFETY INVARIANT: The mock provider is strictly blocked when NODE_ENV=production.
OPENAI_API_KEY=""

# Optional model override. Defaults to "gpt-4o-mini" if omitted.
OPENAI_MODEL="gpt-4o-mini"

# Optional base URL override (e.g. for Azure OpenAI or local inference proxies).
# Defaults to "https://api.openai.com/v1" if omitted.
OPENAI_BASE_URL="https://api.openai.com/v1"

# Explicit screening provider selection. Options: "openai" or "mock".
# Note: "mock" is strictly prohibited in production and will throw AI_PROVIDER_NOT_CONFIGURED.
SCREENING_PROVIDER="openai"

# ------------------------------------------------------------------------------
# 3. Resume Document Storage
# ------------------------------------------------------------------------------
# Current implementation uses local filesystem storage (isolated outside public web root).
STORAGE_DRIVER="local"

# SAFETY GATE FOR PRODUCTION:
# When NODE_ENV=production, LocalStorageProvider rejects uploads by default because
# serverless and multi-instance container environments (Vercel, AWS ECS Fargate, Cloud Run)
# have ephemeral filesystems.
#
# If deploying on a dedicated VPS / VM with a persistent volume mounted to ./storage/resumes,
# explicitly set this flag to "true":
ALLOW_LOCAL_STORAGE_IN_PRODUCTION="false"

# ------------------------------------------------------------------------------
# 4. Optional OCR Engine Fallback
# ------------------------------------------------------------------------------
# Optical Character Recognition key for scanned, non-textual PDF parsing.
# Standard digital PDFs and DOCX files parse automatically via native streams.
# CLOUD_OCR_API_KEY=""

# ------------------------------------------------------------------------------
# 5. Local Development & Demo Seeding (Development Only)
# ------------------------------------------------------------------------------
# Used exclusively by `npx tsx prisma/seed.ts` when creating development seed users.
# In production, default seeded credentials are automatically rejected by the auth engine.
DEMO_USER_PASSWORD=""

# Optional staging override: Set to "true" ONLY if running an isolated staging demo
# where demo auto-fill or seeded demo credentials need to be evaluated in production mode.
ALLOW_DEMO_AUTH_IN_PRODUCTION="false"
