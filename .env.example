# ==============================================================================
# TalentLens - Production & Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your deployment-specific configuration.
# NEVER commit .env to version control or expose production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Neon Serverless / Supabase / RDS)
# ------------------------------------------------------------------------------
# Pooled database connection string for Prisma ORM.
# Required in all environments.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&pgbouncer=true
#
# NEON FREE-TIER REALITIES & LIMITS:
# - Storage Quota: 0.5 GB (512 MB) included storage.
# - Connection Limit: 21 concurrent connections on pooled connection string (-pooler endpoint).
# - Auto-Suspend: Inactive compute endpoints auto-suspend after 5 minutes of idle time.
#   Cold starts take ~1.5 - 3.0 seconds to resume. Ensure Prisma connect_timeout is configured.
# - Direct Migration URL: Run prisma migrate with non-pooled DIRECT_URL to avoid PgBouncer session locks.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talentlens?schema=public"

# Optional direct connection string for database migrations (e.g. Neon serverless direct URL).
# DIRECT_URL="postgresql://postgres:postgres@ep-direct.neon.tech/talentlens?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AI Resume Screening Engine (Groq / OpenAI API)
# ------------------------------------------------------------------------------
# Mandatory in production. The screening engine computes deterministic 100% weighted
# scorecards, extracts verbatim evidence citations, and strips protected demographic attributes.
# SAFETY INVARIANT: The mock provider is strictly blocked when NODE_ENV=production.
#
# Primary Provider: Groq (Recommended zero-cost, high-throughput free-tier inference)
# Endpoint: https://api.groq.com/openai/v1
# Free-tier Model: "llama-3.3-70b-versatile" (or "llama-3.1-8b-instant" for higher throughput)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Fallback / Alternative Provider: OpenAI API
# Optional if GROQ_API_KEY is configured.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Explicit screening provider selection. Options: "groq" (default), "openai", or "mock" (dev/test only).
# If omitted, Groq is automatically prioritized when GROQ_API_KEY is configured.
# Note: "mock" is strictly prohibited in production and will throw AI_PROVIDER_NOT_CONFIGURED.
SCREENING_PROVIDER="groq"

# ------------------------------------------------------------------------------
# 3. Resume Document Storage (Local or Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# Storage driver selection: "local" (for development) or "r2" (for cloud staging/production).
STORAGE_DRIVER="local"

# Cloudflare R2 / S3-Compatible Object Storage (Recommended for Vercel Deployments)
# CLOUDFLARE R2 FREE-TIER REALITIES & LIMITS:
# - Storage Quota: 10 GB / month included storage ($0.015/GB/mo thereafter).
# - Operation Quotas: 1,000,000 Class A operations/month (PutObject, List);
#                     10,000,000 Class B operations/month (GetObject, HeadObject).
# - Egress Fees: $0.00 / GB (R2 has zero data egress fees worldwide, unlike AWS S3).
# - Direct Presigned Upload: Direct browser-to-R2 uploads bypass Vercel's 4.5 MB request body limit.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="talentlens-resumes"
# Optional endpoint override (defaults to https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com)
R2_ENDPOINT=""
R2_REGION="auto"

# SAFETY GATE FOR LOCAL STORAGE IN PRODUCTION:
# When NODE_ENV=production and STORAGE_DRIVER="local", LocalStorageProvider rejects uploads
# by default because serverless container environments (Vercel) have ephemeral filesystems.
# If deploying for a local demo with local storage, set this flag to "true":
ALLOW_LOCAL_STORAGE_IN_PRODUCTION="false"

# ------------------------------------------------------------------------------
# 4. Authentication & Session Architecture (SESSION_SECRET Resolution)
# ------------------------------------------------------------------------------
# NOTE ON SESSION_SECRET:
# TalentLens uses stateful, database-backed sessions with high-entropy cryptographic
# tokens (crypto.randomBytes(32).toString('base64url')) stored in the PostgreSQL Session table.
# The session token is transmitted via an httpOnly, SameSite=Lax, secure cookie (talentlens_session).
# TalentLens DOES NOT use stateless JWTs or symmetric cookie signing, so a SESSION_SECRET
# environment variable is NOT required or read by the application.

# ------------------------------------------------------------------------------
# 5. Hosting Platform Terms (Vercel Hobby vs Pro)
# ------------------------------------------------------------------------------
# VERCEL HOBBY TERMS NOTE:
# Vercel Hobby is strictly limited to non-commercial personal evaluations and hobby projects.
# Commercial SaaS operations or paid recruitment agency usage requires Vercel Pro ($20/mo/user).
# For free-tier staging or portfolio demonstration, Vercel Hobby is fully supported.
# Serverless timeouts are set to maxDuration = 60s for screening and upload routes.

# ------------------------------------------------------------------------------
# 6. Optional OCR Engine Fallback
# ------------------------------------------------------------------------------
# Optical Character Recognition key for scanned, non-textual PDF parsing.
# Standard digital PDFs and DOCX files parse automatically via native streams.
# CLOUD_OCR_API_KEY=""

# ------------------------------------------------------------------------------
# 7. Local Development & Demo Seeding (Development Only)
# ------------------------------------------------------------------------------
# Used exclusively by `npx tsx prisma/seed.ts` when creating development seed users.
# In production, default seeded credentials are automatically rejected by the auth engine.
DEMO_USER_PASSWORD=""

# Optional staging override: Set to "true" ONLY if running an isolated staging demo
# where demo auto-fill or seeded demo credentials need to be evaluated in production mode.
ALLOW_DEMO_AUTH_IN_PRODUCTION="false"
