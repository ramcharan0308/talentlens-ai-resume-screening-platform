# ==============================================================================
# TalentLens - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your local/deployment configuration values.
# NEVER commit .env to version control or expose production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example for local development: postgresql://postgres:postgres@localhost:5432/talentlens?schema=public
# Example for Neon serverless: postgresql://user:pass@ep-cool-pooler.neon.tech/talentlens?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talentlens?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication (Auth.js / NextAuth v5 Placeholder)
# ------------------------------------------------------------------------------
# Generate with `openssl rand -hex 32` or `npx auth secret`
NEXTAUTH_SECRET="placeholder-generate-random-32-byte-hex-secret"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. AI / LLM Provider (Google Gemini API Placeholder)
# ------------------------------------------------------------------------------
# API key for Gemini 3.8 Flash model execution
GEMINI_API_KEY="placeholder-gemini-api-key"

# ------------------------------------------------------------------------------
# 4. Storage Provider (Supabase S3-Compatible / Local Storage Placeholder)
# ------------------------------------------------------------------------------
STORAGE_DRIVER="local" # Options: "local" or "supabase"
STORAGE_ENDPOINT="https://placeholder-project.supabase.co/storage/v1/s3"
STORAGE_ACCESS_KEY="placeholder-storage-access-key"
STORAGE_SECRET_KEY="placeholder-storage-secret-key"
STORAGE_BUCKET_NAME="talentlens-resumes"

